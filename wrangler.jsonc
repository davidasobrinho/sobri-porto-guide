// Cloudflare Worker that serves the guide as static files.
// Cloudflare publishes it automatically on every push to main (Workers Builds).
{
  "name": "sobri-porto-guide",
  "compatibility_date": "2026-10-01",
  // Keep the old workers.dev link working for guests who already have it
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "guide.sobri.pt", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site"
  }
}
